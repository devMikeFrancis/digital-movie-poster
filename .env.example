APP_NAME="Digital Movie Poster"
APP_ENV=production
# Also the encryption key for the media-server credentials in the settings
# table. Do not regenerate it on a running install - see the README.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite keeps the appliance to a single file with no database daemon.
# Leave DB_DATABASE unset to use database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/database/database.sqlite

# Upgrading from a MariaDB install? See "Migrating an existing install" in the
# README, or keep your old settings by uncommenting the block below.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=movieposter
# DB_USERNAME=movieposter
# DB_PASSWORD=

# Redis carries broadcast events to the Node socket server on port 3000.
BROADCAST_CONNECTION=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
FILESYSTEM_DISK=local

# "imagick" gives noticeably better poster resizing; "gd" is the fallback if
# the imagick PHP extension is not installed.
IMAGE_DRIVER=imagick

# Require a login for the admin UI, and a session or bearer token for every
# endpoint that writes, shells out, or returns credentials. The endpoints the
# kiosk display polls stay open either way.
#   php artisan dmp:user             create or reset the admin account
#   php artisan dmp:token "my app"   mint a token for an integration
DMP_REQUIRE_LOGIN=true

# Allow creating the first admin account from the browser. Once an account
# exists this does nothing.
DMP_ALLOW_SETUP=true

# Where the About page checks for updates. Must match the repo you installed from.
DMP_UPDATE_REPOSITORY=devMikeFrancis/digital-movie-poster
DMP_UPDATE_BRANCH=main

# Origins allowed to connect to the Node socket server. Comma separated, or "*"
# to allow any host on your LAN.
SOCKET_ALLOWED_ORIGINS=*
SOCKET_PORT=3000

VITE_BASE_URL="${APP_URL}"
